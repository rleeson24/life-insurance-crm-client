# Standalone API (dotnet run on LifeInsuranceCRM.API):
VITE_API_BASE_URL=https://localhost:7114

# When running via Aspire AppHost, VITE_API_BASE_URL is injected automatically.

# Entra SPA registration (LifeInsuranceCRM-SPA). Same values for local, Azure dev, and prod.
# Redirect URI registered in Entra must match the origin (local: http://localhost:5387/).
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_API_SCOPE=api://2c56c052-f9bf-4db0-bead-d2e2e4e7f4c6/access_as_user
